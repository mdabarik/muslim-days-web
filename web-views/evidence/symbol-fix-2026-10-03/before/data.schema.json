{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "$id":"urn:quran-source:web-page:2.0.0-draft",
 "title":"Source-evidenced draft page, not release-approved Quran",
 "type":"object",
 "required":["schemaVersion","source","candidateSha256","status","fullyVerified","originalCandidate","graphemes","annotations"],
 "properties":{
  "schemaVersion":{"const":"2.0.0-draft"},"status":{"const":"draft"},"fullyVerified":{"const":false},
  "source":{"type":"object","required":["pdf_sha256","pdf_page_number","coordinate_system"]},
  "candidateSha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
  "legacyReview":{"type":["object","null"]},"originalCandidate":{"type":"object"},
  "graphemes":{"type":"object","additionalProperties":{"type":"array","items":{"type":"object","required":["id","text","startCodepoint","endCodepoint","sourceBox","verified"],"properties":{"id":{"type":"string"},"text":{"type":"string","minLength":1},"startCodepoint":{"type":"integer","minimum":0},"endCodepoint":{"type":"integer","minimum":1},"sourceBox":{"type":"null"},"verified":{"const":false}}}}},
  "annotations":{"type":"array","items":{"type":"object","required":["id","sourceId","rowIndex","text","sourceBox","targetGraphemeId","verified","unresolved","draftWordAttachment"],"properties":{"id":{"type":"string"},"sourceId":{"type":"string"},"rowIndex":{"type":"integer","minimum":0},"text":{"type":["string","null"]},"sourceBox":{"type":["array","null"],"items":{"type":"number"},"minItems":4,"maxItems":4},"targetGraphemeId":{"type":"null"},"verified":{"const":false},"unresolved":{"type":"array","minItems":1,"items":{"type":"string"}},"draftWordAttachment":{"type":["object","null"]}}}}
 }
}
